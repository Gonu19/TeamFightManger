# 필요한 환경변수. 실제 값은 커밋하지 않는다.
#
# PowerShell 에서 설정 (따옴표 필수 — 없으면 값을 명령어로 해석한다):
#   $env:TFM_DB_PASSWORD = 'your-password'

# --- 필수 ---
# Postgres 접속 비밀번호. 없으면 앱이 즉시, 명확하게 죽는다.
TFM_DB_PASSWORD=

# --- 선택 (기본값이 있다) ---
# DB 이름. 기본 tfm (테스트는 tfm_test)
TFM_DB_NAME=tfm
# 접속 롤. 기본 postgres
TFM_DB_USER=postgres
# 웹 포트. 기본 8088 (8080 은 다른 로컬 서버가 쓰는 경우가 있다)
TFM_PORT=8088
# 세이브 폴더. 기본은 %USERPROFILE% 아래 게임 기본 경로
TFM_SAVE_DIR=

# --- 기사 생성 (story/) ---
# 기본은 전부 꺼짐이다 (D61). 켜야만 외부로 요청이 나간다.
# 켜지 않아도 적재·집계·통계 화면은 그대로 돈다.
#
# 외부 전송을 켤지. 기본 false
TFM_STORY_ENABLED=
# Groq API 키. https://console.groq.com 에서 발급. 기본은 비워둔다
TFM_GROQ_API_KEY=
# 다른 제공자를 쓸 때만. 기본 https://api.groq.com/openai/v1
# (Cerebras·로컬도 OpenAI 호환이라 이 한 줄로 바뀐다)
TFM_STORY_BASE_URL=
# 모델. 기본 llama-3.3-70b-versatile
TFM_STORY_MODEL=
# 호출 제한 시간(초). 기본 60
TFM_STORY_TIMEOUT=
